# Normalise line endings in the repository, check out native.
* text=auto eol=lf

# PowerShell is happier with CRLF on Windows and these are Windows-only.
*.ps1 text eol=crlf

# Never touch these. Anything here is a bitstream or a metadata blob, and a
# line-ending rewrite would corrupt it silently.
*.mkv binary
*.hevc binary
*.h265 binary
*.bin binary
*.exe binary
*.png binary
*.jpg binary
